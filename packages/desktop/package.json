{
  "name": "@model-agent/desktop",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:preload && vite",
    "predev": "npm run build:preload",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build": "npm run build:preload && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.0.0",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.0.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^12.0.0",
    "pinia": "^2.3.0",
    "reka-ui": "^2.10.1",
    "shiki": "^1.26.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "shadcn-vue": "^2.7.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^1.0.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.4"
  }
}
