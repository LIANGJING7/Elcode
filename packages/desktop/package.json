{
  "name": "@model-agent/desktop",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:preload && vite",
    "predev": "npm run build:preload",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build": "npm run build:preload && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-builder",
    "build:core": "cd ../core && bun run build --single",
    "build:win": "npm run build:core && npm run build && electron-builder --win",
    "build:mac": "npm run build:core && npm run build && electron-builder --mac",
    "build:linux": "npm run build:core && npm run build && electron-builder --linux",
    "build:all": "npm run build:core && npm run build && electron-builder"
  },
  "dependencies": {
    "@model-agent/core": "workspace:*",
    "@radix-icons/vue": "^1.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/vue-virtual": "^3.13.31",
    "@vueuse/core": "^14.3.0",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.0.0",
    "fuzzysort": "^3.1.0",
    "jsonc-parser": "^3.3.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.2.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^12.0.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.3.0",
    "reka-ui": "^2.10.1",
    "shiki": "^1.26.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13",
    "xdg-basedir": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "icns": "^0.1.0",
    "jsdom": "^26.1.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "shadcn-vue": "^2.7.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^1.0.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.4"
  }
}
