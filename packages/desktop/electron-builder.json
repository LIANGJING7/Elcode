{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/schema/schema.json",
  "appId": "com.model-agent.desktop",
  "productName": "Model Agent",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": "dmg",
    "icon": "assets/icons/icon.icns"
  },
  "win": {
    "target": "nsis",
    "icon": "assets/icons/icon.ico"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icons/icon.png"
  }
}